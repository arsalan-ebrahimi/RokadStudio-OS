generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
  SCRUM_ADMIN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DecisionSource {
  USER
  ADMIN
  SYSTEM
}

enum ScrumColor {
  ECOSYSTEM
  MALE
  FEMALE
  COLLEGE
  CLUB
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum ItemStatus {
  TODO
  DOING
  DONE
}

enum EventScheduleType {
  WEEKLY
  ONCE
}

model User {
  id                 Int             @id @default(autoincrement())
  code               String          @unique
  name               String
  role               Role            @default(USER)
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  projectMembers         ProjectMember[]
  attendances            Attendance[]    @relation("UserAttendances")
  decidedAttendances     Attendance[]    @relation("AttendanceDecidedBy")
  workSessions           WorkSession[]
  decidedWorkSessions    WorkSession[]   @relation("WorkSessionDecidedBy")
  createdProjects        Project[]       @relation("CreatedProjects")
  scrumAdmins            ScrumAdmin[]    @relation("ScrumAdminUser")
  assignedScrumAdmins    ScrumAdmin[]    @relation("ScrumAdminAssignedBy")
  scrumMembers           ScrumMember[]   @relation("ScrumMemberUser")
  assignedSprintProjects SprintProject[] @relation("SprintProjectAssignee")
}

model Project {
  id          Int             @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean         @default(true)
  createdById Int
  scrumId     Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  createdBy      User            @relation("CreatedProjects", fields: [createdById], references: [id], onDelete: Restrict)
  scrum          Scrum?          @relation(fields: [scrumId], references: [id], onDelete: SetNull)
  members        ProjectMember[]
  workSessions   WorkSession[]
  sprintProjects SprintProject[]

  @@index([scrumId])
}

model ProjectMember {
  id         Int      @id @default(autoincrement())
  projectId  Int
  userId     Int
  assignedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Scrum {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  color       ScrumColor   @default(ECOSYSTEM)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  admins      ScrumAdmin[]
  members     ScrumMember[]
  projects    Project[]
  sprints     Sprint[]
  kpis        ScrumKpi[]
  events      ScrumEvent[]

  @@index([isActive])
}

model ScrumAdmin {
  scrumId      Int
  userId       Int
  assignedAt   DateTime @default(now())
  assignedById Int?

  scrum      Scrum @relation(fields: [scrumId], references: [id], onDelete: Cascade)
  user       User  @relation("ScrumAdminUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("ScrumAdminAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([scrumId, userId])
  @@index([userId])
  @@index([assignedById])
}

model ScrumMember {
  scrumId Int
  userId  Int
  label   String?

  scrum   Scrum @relation(fields: [scrumId], references: [id], onDelete: Cascade)
  user    User  @relation("ScrumMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([scrumId, userId])
  @@index([userId])
}

model Sprint {
  id          Int          @id @default(autoincrement())
  scrumId     Int
  number      Int
  title       String
  description String?
  startDate   DateTime?    @db.Date
  endDate     DateTime?    @db.Date
  status      SprintStatus @default(PLANNED)
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  scrum       Scrum           @relation(fields: [scrumId], references: [id], onDelete: Cascade)
  projects    SprintProject[]

  @@unique([scrumId, number])
  @@index([scrumId, status])
}

model SprintProject {
  id         Int        @id @default(autoincrement())
  sprintId   Int
  projectId  Int?
  name       String
  points     Int        @default(0)
  assigneeId Int?
  status     ItemStatus @default(TODO)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  sprint       Sprint        @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee     User?         @relation("SprintProjectAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  workSessions WorkSession[]

  @@index([sprintId])
  @@index([projectId])
  @@index([assigneeId])
}

model ScrumKpi {
  id               Int      @id @default(autoincrement())
  scrumId          Int
  indicator        String?
  formula          String?
  strategicGoal    String?
  unit             String?
  target           Decimal? @db.Decimal(12, 2)
  firstMonthTarget Decimal? @db.Decimal(12, 2)
  actualValue      Decimal? @db.Decimal(12, 2)
  minExpected      Decimal? @db.Decimal(12, 2)
  sortOrder        Int      @default(0)
  updatedAt        DateTime @updatedAt

  scrum            Scrum    @relation(fields: [scrumId], references: [id], onDelete: Cascade)

  @@index([scrumId])
}

model ScrumEvent {
  id              Int               @id @default(autoincrement())
  scrumId         Int
  name            String
  scheduleType    EventScheduleType
  dayOfWeek       Int?
  date            DateTime?         @db.Date
  startTime       String?
  durationMinutes Int?
  inputs          String?           @db.Text
  outputs         String?           @db.Text
  sortOrder       Int               @default(0)

  scrum           Scrum             @relation(fields: [scrumId], references: [id], onDelete: Cascade)

  @@index([scrumId])
  @@index([scheduleType, dayOfWeek])
  @@index([scheduleType, date])
}

model Attendance {
  id          Int              @id @default(autoincrement())
  userId      Int
  date        DateTime         @db.Date
  status      AttendanceStatus
  approval    ApprovalStatus
  source      DecisionSource
  decidedById Int?
  decidedAt   DateTime?
  reason      String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user         User            @relation("UserAttendances", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy    User?           @relation("AttendanceDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  workSessions WorkSession[]

  @@unique([userId, date])
  @@index([date, approval])
}

model WorkSession {
  id              Int            @id @default(autoincrement())
  userId          Int
  projectId       Int?
  sprintProjectId Int?
  attendanceId    Int
  durationSeconds Int
  clientRequestId String?        @db.VarChar(64)
  workDate        DateTime       @default(now()) @db.Date
  approval        ApprovalStatus @default(PENDING)
  source          DecisionSource @default(USER)
  decidedById     Int?
  decidedAt       DateTime?
  startedAt       DateTime?
  createdAt       DateTime       @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprintProject SprintProject? @relation(fields: [sprintProjectId], references: [id], onDelete: Restrict)
  attendance    Attendance     @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  decidedBy     User?          @relation("WorkSessionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([userId, clientRequestId])
  @@index([attendanceId])
  @@index([projectId])
  @@index([sprintProjectId])
  @@index([userId, createdAt])
  @@index([workDate])
  @@index([approval])
  @@index([workDate, approval])
}
