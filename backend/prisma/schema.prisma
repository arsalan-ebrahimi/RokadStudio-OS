generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
  SCRUM_ADMIN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DecisionSource {
  USER
  ADMIN
  SYSTEM
}

enum ScrumColor {
  ECOSYSTEM
  MALE
  FEMALE
  COLLEGE
  CLUB
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum EventScheduleType {
  WEEKLY
  ONCE
}

enum KpiStatus {
  BELOW_MIN
  IN_RANGE
  ON_TARGET
}

enum PerformanceLevel {
  EXCELLENT
  STRONG
  AVERAGE
  WEAK
  NEEDS_ATTENTION
}

model User {
  id                 Int             @id @default(autoincrement())
  code               String          @unique
  name               String
  role               Role            @default(USER)
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  projectMembers            ProjectMember[]
  attendances               Attendance[]        @relation("UserAttendances")
  decidedAttendances        Attendance[]        @relation("AttendanceDecidedBy")
  workSessions              WorkSession[]
  decidedWorkSessions       WorkSession[]       @relation("WorkSessionDecidedBy")
  createdProjects           Project[]           @relation("CreatedProjects")
  scrumAdmins               ScrumAdmin[]        @relation("ScrumAdminUser")
  assignedScrumAdmins       ScrumAdmin[]        @relation("ScrumAdminAssignedBy")
  scrumMembers              ScrumMember[]       @relation("ScrumMemberUser")
  updatedScrumPerformances  ScrumMember[]       @relation("ScrumMemberPerformanceUpdatedBy")
  studioPerformance         StudioPerformance?  @relation("UserStudioPerformance")
  updatedStudioPerformances StudioPerformance[] @relation("StudioPerformanceUpdatedBy")
  assignedTasks             TaskMember[]        @relation("TaskMemberUser")
  assignedTaskMembers       TaskMember[]        @relation("TaskMemberAssignedBy")
}

model Project {
  id          Int             @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean         @default(true)
  createdById Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  createdBy    User            @relation("CreatedProjects", fields: [createdById], references: [id], onDelete: Restrict)
  members      ProjectMember[]
  workSessions WorkSession[]
}

model ProjectMember {
  id         Int      @id @default(autoincrement())
  projectId  Int
  userId     Int
  assignedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Scrum {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  color       ScrumColor   @default(ECOSYSTEM)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  admins  ScrumAdmin[]
  members ScrumMember[]
  sprints Sprint[]
  tasks   Task[]
  kpis    ScrumKpi[]
  events  ScrumEvent[]

  @@index([isActive])
}

model ScrumAdmin {
  scrumId      Int
  userId       Int
  assignedAt   DateTime @default(now())
  assignedById Int?

  scrum      Scrum @relation(fields: [scrumId], references: [id], onDelete: Cascade)
  user       User  @relation("ScrumAdminUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("ScrumAdminAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([scrumId, userId])
  @@index([userId])
  @@index([assignedById])
}

model ScrumMember {
  scrumId                Int
  userId                 Int
  label                  String?
  performance            PerformanceLevel?
  performanceNote        String?           @db.VarChar(500)
  performanceUpdatedAt   DateTime?
  performanceUpdatedById Int?

  scrum                Scrum @relation(fields: [scrumId], references: [id], onDelete: Cascade)
  user                 User  @relation("ScrumMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  performanceUpdatedBy User? @relation("ScrumMemberPerformanceUpdatedBy", fields: [performanceUpdatedById], references: [id], onDelete: SetNull)

  @@id([scrumId, userId])
  @@index([userId])
  @@index([performance])
  @@index([performanceUpdatedById])
}

model StudioPerformance {
  userId      Int              @id
  level       PerformanceLevel
  note        String?          @db.VarChar(500)
  updatedAt   DateTime         @updatedAt
  updatedById Int?

  user      User  @relation("UserStudioPerformance", fields: [userId], references: [id], onDelete: Cascade)
  updatedBy User? @relation("StudioPerformanceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([level])
  @@index([updatedById])
}

model Sprint {
  id              Int          @id @default(autoincrement())
  scrumId         Int
  number          Int
  title           String
  description     String?
  startDate       DateTime?    @db.Date
  endDate         DateTime?    @db.Date
  status          SprintStatus @default(PLANNED)
  progressPercent Int          @default(0)
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  scrum Scrum  @relation(fields: [scrumId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([scrumId, number])
  @@index([scrumId, status])
}

model Task {
  id          Int          @id @default(autoincrement())
  scrumId     Int
  sprintId    Int?
  name        String
  description String?
  points      Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  scrum        Scrum         @relation(fields: [scrumId], references: [id], onDelete: Cascade)
  sprint       Sprint?       @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  members      TaskMember[]
  workSessions WorkSession[]

  @@index([scrumId])
  @@index([sprintId])
  @@index([isActive])
}

model TaskMember {
  taskId       Int
  userId       Int
  assignedAt   DateTime @default(now())
  assignedById Int?

  task       Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User  @relation("TaskMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("TaskMemberAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([taskId, userId])
  @@index([userId])
  @@index([assignedById])
}

model ScrumKpi {
  id               Int        @id @default(autoincrement())
  scrumId          Int
  indicator        String?
  formula          String?
  strategicGoal    String?
  unit             String?
  target           String?
  firstMonthTarget String?
  finalTarget      String?
  progressPercent  Decimal?   @db.Decimal(5, 2)
  status           KpiStatus?
  minExpected      Decimal?   @db.Decimal(12, 2)
  sortOrder        Int        @default(0)
  updatedAt        DateTime   @updatedAt

  scrum            Scrum      @relation(fields: [scrumId], references: [id], onDelete: Cascade)

  @@index([scrumId])
}

model ScrumEvent {
  id              Int               @id @default(autoincrement())
  scrumId         Int
  name            String
  scheduleType    EventScheduleType
  dayOfWeek       Int?
  date            DateTime?         @db.Date
  startTime       String?
  durationMinutes Int?
  inputs          String?           @db.Text
  outputs         String?           @db.Text
  sortOrder       Int               @default(0)

  scrum           Scrum             @relation(fields: [scrumId], references: [id], onDelete: Cascade)

  @@index([scrumId])
  @@index([scheduleType, dayOfWeek])
  @@index([scheduleType, date])
}

model Attendance {
  id                 Int              @id @default(autoincrement())
  userId             Int
  date               DateTime         @db.Date
  status             AttendanceStatus
  approval           ApprovalStatus
  source             DecisionSource
  decidedById        Int?
  decidedAt          DateTime?
  reason             String?
  workNote           String?          @db.Text
  workNoteAt         DateTime?
  workNotePromptedAt DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user         User            @relation("UserAttendances", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy    User?           @relation("AttendanceDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  workSessions WorkSession[]

  @@unique([userId, date])
  @@index([date, approval])
  @@index([workNoteAt])
}

model WorkSession {
  id              Int            @id @default(autoincrement())
  userId          Int
  projectId       Int?
  taskId          Int?
  attendanceId    Int
  durationSeconds Int
  clientRequestId String?        @db.VarChar(64)
  workDate        DateTime       @default(now()) @db.Date
  approval        ApprovalStatus @default(PENDING)
  source          DecisionSource @default(USER)
  decidedById     Int?
  decidedAt       DateTime?
  startedAt       DateTime?
  createdAt       DateTime       @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task       Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  decidedBy  User?      @relation("WorkSessionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([userId, clientRequestId])
  @@index([attendanceId])
  @@index([projectId])
  @@index([taskId])
  @@index([userId, createdAt])
  @@index([userId, workDate])
  @@index([workDate])
  @@index([approval])
  @@index([workDate, approval])
}
