# Server Configuration
PORT=5000
NODE_ENV=development
APP_TIMEZONE=Asia/Tehran
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database & Cache
DATABASE_URL=postgresql://rokad_user:rokad_password@127.0.0.1:54320/rokad_attendance_db
REDIS_URL=redis://127.0.0.1:6379

# Authentication
JWT_SECRET=super_secret_jwt_key_with_at_least_32_chars_rokad
JWT_EXPIRES_IN=7d

# Domain Business Rules
SESSION_MAX_SECONDS=1500
MIDNIGHT_GRACE_MINUTES=30
ATTENDANCE_CATCHUP_DAYS=7

# Initial Seed Super Admin
SEED_SUPERADMIN_CODE=999999
SEED_SUPERADMIN_NAME=Studio Super Admin
